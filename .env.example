# AWS — required for RDS connection via connect.py
AWS_REGION=us-west-2
RDS_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>
RDS_HOST=<your-rds-host>.rds.amazonaws.com

# Hugging Face — required to download Qwen3-4B
HF_TOKEN=hf_...

# Provider API keys — required only for the corresponding baseline config
# baseline_gpt55.yaml requires OPENAI_API_KEY
OPENAI_API_KEY=sk-...
# baseline_gemini.yaml requires GOOGLE_API_KEY
GOOGLE_API_KEY=...
